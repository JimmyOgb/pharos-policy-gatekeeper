{
  "version": "1.0.0",
  "policy_id": "pharos-atlantic-guardian-v1",
  "name": "Pharos Atlantic Testnet Standard Protection Policy",
  "description": "Default fail-closed policy safeguarding agent interactions on Pharos Atlantic Testnet (Chain ID 688689). Enforces per-transaction and cumulative spend caps, contract address whitelisting, and authorized UTC operation windows.",
  "network": {
    "chain_id": 688689,
    "name": "Pharos Atlantic Testnet",
    "rpc_url": "https://atlantic.dplabs-internal.com"
  },
  "default_action": "DENY",
  "rules": [
    {
      "id": "rule-spend-limit-01",
      "type": "spend_limit",
      "name": "Maximum Single Transaction and ERC20 Spend Cap",
      "description": "Restricts native PHRS transfers to 1.0 PHRS and test USDC transfers to 100.0 units per execution.",
      "enabled": true,
      "parameters": {
        "max_native_wei": "1000000000000000000",
        "max_cumulative_native_wei": "5000000000000000000",
        "tokens": [
          {
            "symbol": "USDC",
            "contract": "0xcfC8330f4BCAB529c625D12781b1C19466A9Fc8B",
            "decimals": 6,
            "max_amount_raw": "100000000"
          }
        ]
      }
    },
    {
      "id": "rule-allowlist-02",
      "type": "allowlist",
      "name": "Verified Atlantic Contract Whitelist",
      "description": "Permits interactions only with verified Pharos Atlantic infrastructure contracts and recognized dex/token targets.",
      "enabled": true,
      "parameters": {
        "allow_unknown_targets": false,
        "allowed_addresses": [
          {
            "address": "0xcA11bde05977b3631167028862bE2a173976CA11",
            "name": "MultiCall3"
          },
          {
            "address": "0xcfC8330f4BCAB529c625D12781b1C19466A9Fc8B",
            "name": "Atlantic USDC"
          },
          {
            "address": "0x76A4De34D608AEf6003117565868E079d20c57F9",
            "name": "Atlantic WPHRS"
          },
          {
            "address": "0x1111111254fb6c44bac0bed2854e76f90643097d",
            "name": "Operations Safe"
          }
        ],
        "allowed_function_selectors": [
          {
            "selector": "0x095ea7b3",
            "name": "approve(address,uint256)"
          },
          {
            "selector": "0xa9059cbb",
            "name": "transfer(address,uint256)"
          },
          {
            "selector": "0xd0e30db0",
            "name": "deposit()"
          },
          {
            "selector": "0x2e1a7d4d",
            "name": "withdraw(uint256)"
          },
          {
            "selector": "0xbce38bd7",
            "name": "tryAggregate(bool,(address,bytes)[])"
          }
        ]
      }
    },
    {
      "id": "rule-time-window-03",
      "type": "time_window",
      "name": "Authorized Business Hours Window",
      "description": "Permits autonomous executions only during active operating hours (08:00 to 20:00 UTC) on weekdays.",
      "enabled": true,
      "parameters": {
        "timezone": "UTC",
        "allowed_start_utc": "08:00:00",
        "allowed_end_utc": "20:00:00",
        "allowed_days_of_week": [
          "MONDAY",
          "TUESDAY",
          "WEDNESDAY",
          "THURSDAY",
          "FRIDAY"
        ]
      }
    }
  ]
}
